rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // Lets the login page know whether first-time setup is done
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Each user reads their own profile; admin reads all. Only the backend writes.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Verification logs: ADMIN ONLY. Admin may only record a decision/note.
    match /checks/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['adminDecision', 'adminDecisionAt', 'adminNote']);
      allow create, delete: if false;
    }

    // Sent notifications log: admin read-only
    match /notifications/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Everything else (refs, etc.) is backend-only
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
