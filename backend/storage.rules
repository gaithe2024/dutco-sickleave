rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // HR users can upload into their own folder only, and can never read files back.
    // Only the admin can view certificate images.
    match /uploads/{uid}/{file} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
            || request.resource.contentType == 'application/pdf');
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      allow update, delete: if false;
    }
  }
}
